<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<template id="__bundler_thumbnail" data-bg-color="#f0eee6">
  <svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
    <rect width="1200" height="800" fill="#f0eee6"/>
    <g transform="translate(600 360)">
      <ellipse cx="0" cy="220" rx="150" ry="22" fill="#61c3d9" opacity="0.28"/>
      <ellipse cx="0" cy="-150" rx="90" ry="20" fill="none" stroke="#c9c4b4" stroke-width="4"/>
      <path d="M-90 -150 q0 240 90 240 q90 0 90 -240 z" fill="#ffffff" opacity="0.55" stroke="#c9c4b4" stroke-width="4"/>
      <circle cx="-16" cy="60" r="14" fill="#ee7067"/>
      <circle cx="14" cy="68" r="9" fill="#ee7067" opacity="0.7"/>
    </g>
    <text x="600" y="700" text-anchor="middle" font-family="Georgia, serif" font-style="italic" font-size="40" fill="#5a6a6d">el lugar más pequeño</text>
  </svg>
</template>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:ital,wght@0,500;0,600;0,700;1,600&amp;family=Barlow+Condensed:wght@400;500;600&amp;family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&amp;display=swap" rel="stylesheet">
<style>
  html,body{margin:0;padding:0;background:#e8e5d9;}
  *{box-sizing:border-box;}
  ::selection{background:rgba(238,112,103,.25);}
  @keyframes bloomFloat{0%{transform:translate3d(0,0,0) scale(.9);opacity:0;}12%{opacity:.5;}50%{opacity:.32;}88%{opacity:.4;}100%{transform:translate3d(0,-26px,0) scale(1.18);opacity:0;}}
  @keyframes lampBreathe{0%,100%{opacity:.78;transform:scale(1);}50%{opacity:1;transform:scale(1.05);}}
  @keyframes wormPulse{0%,100%{transform:scale(1);opacity:.85;}50%{transform:scale(.78);opacity:.55;}}
  @keyframes rimGlint{0%,100%{opacity:.35;}50%{opacity:.9;}}
  @keyframes rise{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
  @media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important;}}
</style>
</helmet>

<div style="{{ shell }}">

  <div aria-hidden="true" style="{{ glowStyle }}"></div>

  <sc-if value="{{ textureOn }}" hint-placeholder-val="{{ true }}">
    <div aria-hidden="true" style="position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1;">
      <span style="position:absolute;left:8%;top:62%;width:120px;height:120px;border-radius:50%;background:radial-gradient(circle at 40% 35%, var(--bloom), transparent 68%);filter:blur(2px);animation:bloomFloat 11s ease-in-out infinite;"></span>
      <span style="position:absolute;left:78%;top:24%;width:90px;height:90px;border-radius:50%;background:radial-gradient(circle at 40% 35%, var(--bloom), transparent 68%);filter:blur(2px);animation:bloomFloat 13s ease-in-out 2.5s infinite;"></span>
      <span style="position:absolute;left:30%;top:18%;width:64px;height:64px;border-radius:50%;background:radial-gradient(circle at 40% 35%, var(--bloom), transparent 68%);filter:blur(2px);animation:bloomFloat 9.5s ease-in-out 1.2s infinite;"></span>
      <span style="position:absolute;left:62%;top:74%;width:104px;height:104px;border-radius:50%;background:radial-gradient(circle at 40% 35%, var(--bloom), transparent 68%);filter:blur(2px);animation:bloomFloat 12.5s ease-in-out 3.4s infinite;"></span>
    </div>
  </sc-if>

  <div style="position:relative;z-index:3;max-width:1240px;margin:0 auto;padding:0 clamp(20px,5vw,64px);">

    <header style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:26px 0 8px;">
      <div style="display:flex;align-items:center;gap:11px;">
        <span style="position:relative;width:26px;height:26px;border-radius:50% 50% 48% 48%/58% 58% 42% 42%;background:linear-gradient(180deg,rgba(255,255,255,.55),rgba(255,255,255,.12));border:1.5px solid var(--rim);box-shadow:inset 0 4px 7px rgba(255,255,255,.5), inset 0 -3px 6px var(--rimShade);display:inline-block;">
          <span style="position:absolute;left:50%;bottom:5px;transform:translateX(-50%);width:5px;height:5px;border-radius:50%;background:var(--accent);"></span>
        </span>
        <span style="font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;letter-spacing:.18em;font-size:13px;font-weight:600;color:var(--ink-soft);">El lugar más pequeño</span>
      </div>
      
    </header>

    <main style="padding:clamp(18px,4vw,40px) 0 clamp(48px,6vw,72px);">

      <section style="display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(24px,5vw,64px);align-items:center;min-height:clamp(420px,64vh,640px);">

        <div style="animation:rise .7s ease both;">
          <div style="display:inline-flex;align-items:center;gap:9px;font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;letter-spacing:.16em;font-size:14px;font-weight:600;color:var(--accent);margin-bottom:22px;">
            <span style="width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--accentSoft);"></span>
            <span ref="{{ kickerRef }}">{{ kicker }}</span>
          </div>

          <h1 style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:700;line-height:.97;letter-spacing:-.015em;font-size:clamp(38px,6vw,76px);color:var(--ink);margin:0 0 22px;text-wrap:balance;">{{ headPre }}<span ref="{{ wordRef }}" style="color:var(--accent);transition:opacity .45s ease;">{{ headWord }}</span>{{ headPost }}</h1>

          <p style="font-family:'Montserrat',sans-serif;font-weight:400;font-size:clamp(16px,1.45vw,20px);line-height:1.62;color:var(--ink-soft);max-width:30em;margin:0 0 34px;">{{ sub }}</p>

          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px 20px;margin-bottom:30px;">
            <a href="#autochequeo" style="{{ ctaStyle }}" style-hover="transform:translateY(-2px);box-shadow:0 14px 30px var(--accentSoft);" style-focus="outline:3px solid var(--accent);outline-offset:3px;">
              <span>{{ ctaPrimary }}</span>
              <span aria-hidden="true" style="transition:transform .3s ease;">→</span>
            </a>
            <span style="font-family:'Montserrat',sans-serif;font-size:13.5px;line-height:1.5;color:var(--ink-faint);max-width:24em;">{{ ctaNote }}</span>
          </div>

          <p style="font-family:'Barlow Semi Condensed',sans-serif;font-style:italic;font-weight:500;font-size:clamp(17px,1.5vw,21px);color:var(--ink-soft);margin:0;opacity:.9;">Que ocupe el lugar más pequeño de tu vida.</p>
        </div>

        <div style="position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:340px;animation:rise .9s ease .12s both;">

          <div aria-hidden="true" style="position:relative;width:clamp(190px,24vw,250px);height:clamp(200px,26vw,270px);margin-bottom:30px;">
            <div style="position:absolute;left:50%;top:54%;transform:translate(-50%,-50%);width:118%;height:118%;border-radius:50%;background:radial-gradient(circle, var(--lifeGlow) 0%, transparent 64%);"></div>
            <div style="position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:84%;height:11px;border-radius:50%;background:var(--shadow);filter:blur(7px);"></div>
            <div style="position:absolute;left:50%;top:6px;transform:translateX(-50%);width:74%;height:20px;border-radius:50%;border:1.5px solid var(--rim);border-bottom-color:transparent;background:linear-gradient(180deg,rgba(255,255,255,.5),transparent);animation:rimGlint 6s ease-in-out infinite;"></div>
            <div style="position:absolute;left:50%;top:14px;transform:translateX(-50%);width:74%;height:calc(100% - 22px);border-radius:18px 18px 46% 46%/14px 14px 30% 30%;background:linear-gradient(150deg,rgba(255,255,255,.34),rgba(255,255,255,.06) 52%,rgba(255,255,255,.18));-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);border:1.5px solid var(--rim);box-shadow:inset 5px 6px 14px rgba(255,255,255,.5), inset -6px -8px 16px var(--rimShade), 0 18px 36px var(--shadow);overflow:hidden;">
              <span style="position:absolute;left:14%;top:8%;width:20%;height:62%;border-radius:50%;background:linear-gradient(180deg,rgba(255,255,255,.7),transparent);filter:blur(1px);"></span>
              <span style="position:absolute;right:12%;top:18%;width:7%;height:44%;border-radius:50%;background:rgba(255,255,255,.45);"></span>
            </div>
            <div style="position:absolute;left:50%;bottom:11%;transform:translateX(-50%);display:flex;gap:5px;align-items:flex-end;">
              <span style="width:11px;height:11px;border-radius:50%;background:var(--accent);animation:wormPulse 3.4s ease-in-out infinite;"></span>
              <span style="width:7px;height:7px;border-radius:50%;background:var(--accent);opacity:.7;animation:wormPulse 3.4s ease-in-out .5s infinite;"></span>
              <span style="width:5px;height:5px;border-radius:50%;background:var(--accent);opacity:.5;animation:wormPulse 3.4s ease-in-out 1s infinite;"></span>
            </div>
          </div>

          <div style="text-align:center;border-top:1px solid var(--line);padding-top:24px;width:min(100%,360px);">
            <div ref="{{ counterRef }}" style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:700;font-size:clamp(72px,11vw,150px);line-height:.82;letter-spacing:-.02em;color:var(--accent);">{{ counterInit }}</div>
            <p style="font-family:'Montserrat',sans-serif;font-weight:400;font-size:clamp(14px,1.2vw,16px);line-height:1.5;color:var(--ink-soft);margin:14px auto 0;max-width:26em;">{{ counterLabel }}</p>
          </div>

        </div>

      </section>

      <section id="autochequeo" style="margin-top:clamp(40px,6vw,80px);">
        <p style="font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;letter-spacing:.16em;font-size:14px;font-weight:600;color:var(--ink-faint);margin:0 0 22px;">{{ cardsKicker }}</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(248px,1fr));gap:18px;">

          <a href="#" style="{{ cardStyle }}" style-hover="transform:translateY(-4px);border-color:var(--coral);box-shadow:0 20px 40px var(--shadow);" style-focus="outline:3px solid var(--coral);outline-offset:3px;">
            <span style="display:flex;width:40px;height:40px;border-radius:50%;align-items:center;justify-content:center;background:var(--coralSoft);color:var(--coral);font-family:'Barlow Semi Condensed';font-weight:700;font-size:20px;margin-bottom:18px;">?</span>
            <h3 style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:700;font-size:25px;line-height:1.05;color:var(--ink);margin:0 0 10px;">¿Será urticaria?</h3>
            <p style="font-family:'Montserrat',sans-serif;font-weight:400;font-size:14.5px;line-height:1.58;color:var(--ink-soft);margin:0 0 20px;flex:1;">Reconoce las señales y distingue lo agudo de lo crónico: más de 6 semanas, sin un detonante claro. Un autochequeo que te orienta, no te diagnostica.</p>
            <span style="font-family:'Barlow Semi Condensed';font-weight:600;font-size:15px;color:var(--coral);display:inline-flex;gap:7px;align-items:center;">Hacer el autochequeo <span aria-hidden="true">→</span></span>
          </a>

          <a href="#" style="{{ cardStyle }}" style-hover="transform:translateY(-4px);border-color:var(--cerulean);box-shadow:0 20px 40px var(--shadow);" style-focus="outline:3px solid var(--cerulean);outline-offset:3px;">
            <span style="display:flex;width:40px;height:40px;border-radius:50%;align-items:center;justify-content:center;background:var(--ceruleanSoft);color:var(--cerulean);margin-bottom:18px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.6-.8L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 8.5-8.5 8.38 8.38 0 0 1 8.5 8.5z"></path></svg>
            </span>
            <h3 style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:700;font-size:25px;line-height:1.05;color:var(--ink);margin:0 0 10px;">No lo estás imaginando</h3>
            <p style="font-family:'Montserrat',sans-serif;font-weight:400;font-size:14.5px;line-height:1.58;color:var(--ink-soft);margin:0 0 20px;flex:1;">Otras personas la viven, y aprendieron a vivirla en pequeño. Sus historias, sin filtros, para que sepas que esto tiene nombre y compañía.</p>
            <span style="font-family:'Barlow Semi Condensed';font-weight:600;font-size:15px;color:var(--cerulean);display:inline-flex;gap:7px;align-items:center;">Leer a la comunidad <span aria-hidden="true">→</span></span>
          </a>

          <a href="#" style="{{ cardStyle }}" style-hover="transform:translateY(-4px);border-color:var(--jasmineLine);box-shadow:0 20px 40px var(--shadow);" style-focus="outline:3px solid var(--jasmineLine);outline-offset:3px;">
            <span style="display:flex;width:40px;height:40px;border-radius:50%;align-items:center;justify-content:center;background:var(--jasmineSoft);color:var(--jasmineInk);margin-bottom:18px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-6 0v4"></path><path d="M5 9h14l1 12H4L5 9z"></path></svg>
            </span>
            <h3 style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:700;font-size:25px;line-height:1.05;color:var(--ink);margin:0 0 10px;">Hay algo más que puedes hacer</h3>
            <p style="font-family:'Montserrat',sans-serif;font-weight:400;font-size:14.5px;line-height:1.58;color:var(--ink-soft);margin:0 0 20px;flex:1;">Lleva a tu próxima consulta las palabras justas: «¿hay algo más que podamos intentar?». Te ayudamos a prepararla.</p>
            <span style="font-family:'Barlow Semi Condensed';font-weight:600;font-size:15px;color:var(--jasmineInk);display:inline-flex;gap:7px;align-items:center;">Preparar mi consulta <span aria-hidden="true">→</span></span>
          </a>

        </div>
      </section>

    </main>

    <footer style="border-top:1px solid var(--line);padding:26px 0 40px;display:flex;flex-wrap:wrap;gap:16px 32px;align-items:baseline;justify-content:space-between;">
      <p style="font-family:'Barlow Semi Condensed',sans-serif;font-style:italic;font-weight:500;font-size:18px;color:var(--ink-soft);margin:0;">Que ocupe el lugar más pequeño de tu vida.</p>
      <p style="font-family:'Montserrat',sans-serif;font-weight:400;font-size:12px;line-height:1.55;color:var(--ink-faint);margin:0;max-width:46em;">Este contenido es solo información general y no sustituye el consejo médico. Si tienes síntomas, habla con un profesional de la salud. Tu hora, zona y estación se detectan solo en tu dispositivo, de forma anónima.</p>
    </footer>

  </div>

  <div role="group" aria-label="Vista previa de contexto" style="{{ switcherStyle }}">
    <span style="font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:600;opacity:.6;padding:0 4px;">Vista</span>
    <sc-for list="{{ ctxOptions }}" as="opt" hint-placeholder-count="6">
      <button type="button" onClick="{{ opt.onClick }}" style="{{ opt.style }}">{{ opt.label }}</button>
    </sc-for>
  </div>

</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;forceContext&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;auto&quot;,&quot;dia&quot;,&quot;calor&quot;,&quot;frio&quot;,&quot;madrugada&quot;,&quot;noche-calor&quot;],&quot;default&quot;:&quot;auto&quot;,&quot;tsType&quot;:&quot;string&quot;},&quot;city&quot;:{&quot;editor&quot;:&quot;text&quot;,&quot;default&quot;:&quot;Mérida&quot;,&quot;tsType&quot;:&quot;string&quot;},&quot;showTexture&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;}}">
class Component extends DCLogic {
  constructor(props){
    super(props);
    this.countRef = React.createRef();
    this.kickerRef = React.createRef();
    this.wordRef = React.createRef();
    this.counterRef = React.createRef();
    this.state = {
      textureOn: props.showTexture !== false,
      forced: null
    };
    this._timers = [];
    this._raf = null;
    this._activeCtx = null;
    this._reduce = false;
  }

  componentDidMount(){
    try { this._reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch(e){}
    this.startClock();
    this.startDynamics();
  }
  componentDidUpdate(){
    const ctx = this.computeCtx();
    if (ctx !== this._activeCtx) this.startDynamics();
  }
  componentWillUnmount(){ this.clearAll(); }

  clearAll(){
    this._timers.forEach(t=>clearInterval(t)); this._timers=[];
    if(this._raf) cancelAnimationFrame(this._raf);
  }

  computeCtx(){
    if (this.state.forced) return this.state.forced;
    const f = this.props.forceContext;
    if (f && f !== 'auto') return f;
    const now = new Date();
    const h = now.getHours();
    const m = now.getMonth(); // 0-11
    const winter = (m === 11 || m === 0 || m === 1);
    const summer = (m >= 4 && m <= 8); // may-sep (calor en MX)
    if (h >= 0 && h < 6) return summer ? 'noche-calor' : 'madrugada';
    if (winter) return 'frio';
    if (summer) return 'calor';
    return 'dia';
  }

  isDark(ctx){ return ctx === 'madrugada' || ctx === 'noche-calor'; }
  counterTarget(ctx){ return this.isDark(ctx) ? 18 : 1240; }

  greeting(){
    const h = new Date().getHours();
    if (h < 12) return 'Buenos días';
    if (h < 19) return 'Buenas tardes';
    return 'Buenas noches';
  }
  clockText(){
    const n = new Date();
    let h = n.getHours(); const m = n.getMinutes();
    const ap = h < 12 ? 'a.m.' : 'p.m.';
    h = h % 12; if (h === 0) h = 12;
    return h + ':' + (m<10?'0':'') + m + ' ' + ap;
  }

  fixedTime(ctx){
    if (ctx === 'madrugada') return '3:15 a.m.';
    if (ctx === 'noche-calor') return '9:00 p.m.';
    return this.clockText();
  }
  startClock(){
    const tick = () => {
      const ctx = this.computeCtx();
      if (this.isDark(ctx) && this.kickerRef.current) {
        this.kickerRef.current.textContent = 'Son las ' + this.fixedTime(ctx);
      }
    };
    tick();
    this._timers.push(setInterval(tick, 1000 * 20));
  }

  startDynamics(){
    this.clearAll();
    this.startClock();
    const ctx = this.computeCtx();
    this._activeCtx = ctx;
    const target = this.counterTarget(ctx);
    const fmt = (v) => Math.round(v).toLocaleString('es-MX');
    if (this.counterRef.current) {
      if (this._reduce) {
        this.counterRef.current.textContent = fmt(target);
      } else {
        const dur = 1500; const start = performance.now();
        const step = (t) => {
          const p = Math.min(1, (t - start) / dur);
          const e = 1 - Math.pow(1 - p, 3);
          if (this.counterRef.current) this.counterRef.current.textContent = fmt(target * e);
          if (p < 1) this._raf = requestAnimationFrame(step);
        };
        this._raf = requestAnimationFrame(step);
      }
    }
    // modular headline word cycle (only 'dia')
    if (ctx === 'dia' && !this._reduce && this.wordRef.current) {
      const words = ['la comezón', 'los brotes', 'el insomnio', 'la incertidumbre'];
      let i = 0;
      this._timers.push(setInterval(() => {
        const el = this.wordRef.current; if (!el) return;
        el.style.opacity = '0';
        setTimeout(() => { i = (i + 1) % words.length; el.textContent = words[i]; el.style.opacity = '1'; }, 420);
      }, 2900));
    }
  }

  theme(ctx){
    const T = {
      'dia': {
        bg:'radial-gradient(1100px 680px at 78% -8%, rgba(97,195,217,.30), transparent 60%), radial-gradient(900px 560px at 6% 108%, rgba(253,217,183,.55), transparent 58%), #f0eee6',
        ink:'#22383f', inkSoft:'#5a6a6d', inkFaint:'#8b9698',
        accent:'#ee7067', accentSoft:'rgba(238,112,103,.16)',
        line:'#dcd8c9', card:'#fffdf8', cardBorder:'#e6e2d4',
        lifeGlow:'rgba(97,195,217,.5)', bloom:'rgba(238,112,103,.22)',
        rim:'rgba(255,255,255,.7)', rimShade:'rgba(120,150,160,.28)', shadow:'rgba(80,110,120,.22)'
      },
      'calor': {
        bg:'radial-gradient(1000px 640px at 82% -6%, rgba(252,215,105,.55), transparent 58%), radial-gradient(900px 560px at 4% 106%, rgba(238,112,103,.38), transparent 56%), #fbf2e6',
        ink:'#4a2a22', inkSoft:'#7a5448', inkFaint:'#a98a7c',
        accent:'#e0584d', accentSoft:'rgba(224,88,77,.16)',
        line:'#ecd9c4', card:'#fffaf2', cardBorder:'#f0dcc6',
        lifeGlow:'rgba(252,215,105,.6)', bloom:'rgba(238,112,103,.26)',
        rim:'rgba(255,255,255,.72)', rimShade:'rgba(180,120,80,.26)', shadow:'rgba(150,90,50,.2)'
      },
      'frio': {
        bg:'radial-gradient(1000px 640px at 80% -8%, rgba(97,195,217,.42), transparent 58%), radial-gradient(900px 560px at 4% 108%, rgba(255,255,255,.85), transparent 56%), #eaf1f3',
        ink:'#1c3b44', inkSoft:'#4f6970', inkFaint:'#85999e',
        accent:'#0081a8', accentSoft:'rgba(0,129,168,.14)',
        line:'#d3e0e3', card:'#fbfdfe', cardBorder:'#dde9eb',
        lifeGlow:'rgba(97,195,217,.55)', bloom:'rgba(97,195,217,.28)',
        rim:'rgba(255,255,255,.85)', rimShade:'rgba(90,140,155,.26)', shadow:'rgba(60,110,125,.2)'
      },
      'madrugada': {
        bg:'radial-gradient(820px 620px at 76% 14%, rgba(252,215,105,.18), transparent 56%), radial-gradient(700px 540px at 70% 8%, rgba(238,112,103,.10), transparent 60%), #15151b',
        ink:'#ece4d7', inkSoft:'#a59c8e', inkFaint:'#6f6a62',
        accent:'#f0c24f', accentSoft:'rgba(240,194,79,.16)',
        line:'rgba(255,255,255,.10)', card:'rgba(255,255,255,.045)', cardBorder:'rgba(255,255,255,.10)',
        lifeGlow:'rgba(252,215,105,.32)', bloom:'rgba(240,194,79,.10)',
        rim:'rgba(255,240,210,.5)', rimShade:'rgba(0,0,0,.4)', shadow:'rgba(0,0,0,.5)'
      },
      'noche-calor': {
        bg:'radial-gradient(840px 640px at 74% 12%, rgba(238,112,103,.22), transparent 56%), radial-gradient(680px 520px at 72% 6%, rgba(252,215,105,.14), transparent 60%), #1a1418',
        ink:'#f0e5db', inkSoft:'#ad9d92', inkFaint:'#776861',
        accent:'#f08a72', accentSoft:'rgba(240,138,114,.18)',
        line:'rgba(255,255,255,.10)', card:'rgba(255,255,255,.05)', cardBorder:'rgba(255,255,255,.11)',
        lifeGlow:'rgba(238,112,103,.34)', bloom:'rgba(240,138,114,.12)',
        rim:'rgba(255,225,205,.5)', rimShade:'rgba(0,0,0,.42)', shadow:'rgba(0,0,0,.5)'
      }
    };
    return T[ctx] || T['dia'];
  }

  copy(ctx){
    const city = this.props.city || 'Mérida';
    const C = {
      'dia': {
        kicker: this.greeting(),
        headPre:'Tu vida es más grande que ', headWord:'la comezón', headPost:' de la urticaria.',
        sub:'Entender qué te pasa es el primer paso para que ocupe menos espacio. Te acompañamos a llegar lista a tu próxima consulta.',
        ctaPrimary:'Descúbrelo en 1 minuto',
        ctaNote:'Un autochequeo que te orienta. No reemplaza a tu médico.',
        counterLabel:'personas usaron esta guía esta semana para entender qué les pasa.'
      },
      'calor': {
        kicker:'En ' + city + ', ahora mismo',
        headPre:'En ' + city + ' el calor está fuerte. Y el calor puede subir ', headWord:'los brotes', headPost:'.',
        sub:'No es tu imaginación: el calor y la humedad despiertan la piel. Esto puede ayudarte hoy a entender qué te pasa.',
        ctaPrimary:'Esto puede ayudarte hoy',
        ctaNote:'Un autochequeo que te orienta. No reemplaza a tu médico.',
        counterLabel:'personas usaron esta guía esta semana para entender qué les pasa.'
      },
      'frio': {
        kicker:'Con el frío de esta temporada',
        headPre:'Con el frío, a algunas personas la piel se les ', headWord:'brota', headPost:'.',
        sub:'Sí, existe la urticaria por frío, y el aire seco del invierno irrita la piel. Esto ayuda a entender qué te pasa.',
        ctaPrimary:'Entiende qué te pasa',
        ctaNote:'Un autochequeo que te orienta. No reemplaza a tu médico.',
        counterLabel:'personas usaron esta guía esta semana para entender qué les pasa.'
      },
      'madrugada': {
        kicker:'Son las ' + this.fixedTime('madrugada'),
        headPre:'¿No puedes ', headWord:'dormir', headPost:'?',
        sub:'La comezón aparece justo cuando todo se queda en silencio. Respira: no estás sola, y esto pasa. Quédate, te acompañamos.',
        ctaPrimary:'Quédate un momento',
        ctaNote:'Sin prisa. Cuando amanezca, esto puede ayudarte a entender qué pasa.',
        counterLabel:'personas están despiertas, leyendo esto contigo, ahora mismo.'
      },
      'noche-calor': {
        kicker:'Son las ' + this.fixedTime('noche-calor'),
        headPre:'La noche está calurosa, y la comezón no te deja ', headWord:'dormir', headPost:'.',
        sub:'El calor de esta noche aviva la piel. Respira: no estás sola, y esto pasa. Quédate, te acompañamos.',
        ctaPrimary:'Quédate un momento',
        ctaNote:'Sin prisa. Cuando amanezca, esto puede ayudarte a entender qué pasa.',
        counterLabel:'personas están despiertas, leyendo esto contigo, ahora mismo.'
      }
    };
    return C[ctx] || C['dia'];
  }

  renderVals(){
    const ctx = this.computeCtx();
    const t = this.theme(ctx);
    const c = this.copy(ctx);
    const dark = this.isDark(ctx);

    const shell = {
      position:'relative', minHeight:'100vh', width:'100%', overflow:'hidden',
      fontFamily:"'Montserrat', sans-serif", color:t.ink, background:t.bg,
      transition:'background .8s ease, color .6s ease',
      // theme vars consumed by literal var() styles in the template
      '--ink':t.ink, '--ink-soft':t.inkSoft, '--ink-faint':t.inkFaint,
      '--accent':t.accent, '--accentSoft':t.accentSoft,
      '--line':t.line, '--rim':t.rim, '--rimShade':t.rimShade, '--shadow':t.shadow,
      '--lifeGlow':t.lifeGlow, '--bloom':t.bloom,
      '--coral': dark ? '#f08a72' : '#ee7067',
      '--coralSoft': dark ? 'rgba(240,138,114,.16)' : 'rgba(238,112,103,.14)',
      '--cerulean': dark ? '#5fbcd6' : '#0081a8',
      '--ceruleanSoft': dark ? 'rgba(95,188,214,.16)' : 'rgba(0,129,168,.12)',
      '--jasmineInk': dark ? '#f0c24f' : '#b07d0a',
      '--jasmineSoft': dark ? 'rgba(240,194,79,.18)' : 'rgba(252,215,105,.30)',
      '--jasmineLine': dark ? '#f0c24f' : '#e7b94a'
    };

    const glowStyle = dark ? {
      position:'absolute', right:'14%', top:'2%', width:'min(46vw,540px)', height:'min(46vw,540px)',
      borderRadius:'50%', zIndex:2, pointerEvents:'none',
      background:'radial-gradient(circle, '+t.lifeGlow+' 0%, transparent 66%)',
      filter:'blur(6px)', animation: this._reduce ? 'none' : 'lampBreathe 7s ease-in-out infinite'
    } : { position:'absolute', inset:0, zIndex:0, pointerEvents:'none' };

    const ctaBg = dark ? t.accent : t.accent;
    const ctaInk = dark ? '#241a12' : '#fff';
    const ctaStyle = {
      display:'inline-flex', alignItems:'center', gap:'10px',
      fontFamily:"'Barlow Semi Condensed', sans-serif", fontWeight:700, fontSize:'18px',
      letterSpacing:'.01em', textDecoration:'none', color:ctaInk, background:ctaBg,
      padding:'15px 26px', borderRadius:'40px',
      boxShadow:'0 10px 24px '+t.accentSoft, transition:'transform .3s ease, box-shadow .3s ease'
    };

    const cardStyle = {
      display:'flex', flexDirection:'column', textDecoration:'none',
      background:t.card, border:'1px solid '+t.cardBorder, borderRadius:'18px',
      padding:'26px 24px 24px', minHeight:'230px',
      transition:'transform .3s ease, box-shadow .3s ease, border-color .3s ease',
      backdropFilter: dark ? 'blur(6px)' : 'none'
    };

    const texBtnStyle = {
      fontFamily:"'Barlow Condensed', sans-serif", textTransform:'uppercase', letterSpacing:'.12em',
      fontSize:'12px', fontWeight:600, cursor:'pointer',
      color:t.inkSoft, background:'transparent', border:'1px solid '+t.line,
      padding:'8px 14px', borderRadius:'30px', opacity:.82, transition:'opacity .2s ease'
    };

    const switcherStyle = {
      position:'fixed', left:'50%', bottom:'18px', transform:'translateX(-50%)', zIndex:40,
      display:'flex', alignItems:'center', gap:'4px', flexWrap:'wrap', justifyContent:'center',
      padding:'6px 8px', borderRadius:'40px',
      background: dark ? 'rgba(28,26,32,.82)' : 'rgba(255,255,255,.82)',
      color: dark ? '#ece4d7' : '#3a4a4d',
      border:'1px solid '+(dark?'rgba(255,255,255,.12)':'rgba(0,0,0,.08)'),
      boxShadow:'0 10px 30px rgba(0,0,0,.18)', backdropFilter:'blur(10px)',
      maxWidth:'calc(100vw - 24px)'
    };

    const active = this.state.forced || (this.props.forceContext && this.props.forceContext!=='auto' ? null : null);
    const mkOpt = (key,label) => {
      const on = this.state.forced === key;
      return {
        label, onClick: () => this.setState({ forced: key }),
        style: {
          fontFamily:"'Barlow Condensed', sans-serif", textTransform:'uppercase', letterSpacing:'.08em',
          fontSize:'12px', fontWeight:600, cursor:'pointer', whiteSpace:'nowrap',
          border:'none', borderRadius:'30px', padding:'8px 13px', transition:'all .2s ease',
          color: on ? (dark?'#241a12':'#fff') : 'inherit',
          background: on ? t.accent : 'transparent', opacity: on ? 1 : .72
        }
      };
    };
    const ctxOptions = [
      { label:'Auto', onClick:()=>this.setState({forced:null}), style:{ fontFamily:"'Barlow Condensed', sans-serif", textTransform:'uppercase', letterSpacing:'.08em', fontSize:'12px', fontWeight:600, cursor:'pointer', whiteSpace:'nowrap', border:'none', borderRadius:'30px', padding:'8px 13px', transition:'all .2s ease', color: this.state.forced===null ? (dark?'#241a12':'#fff') : 'inherit', background: this.state.forced===null ? t.accent : 'transparent', opacity: this.state.forced===null ? 1 : .72 } },
      mkOpt('dia','Día'),
      mkOpt('calor','Calor'),
      mkOpt('frio','Frío'),
      mkOpt('madrugada','Madrugada'),
      mkOpt('noche-calor','Noche cálida')
    ];

    return {
      shell, glowStyle,
      textureOn: this.state.textureOn,
      toggleTexture: () => this.setState(s => ({ textureOn: !s.textureOn })),
      texBtnStyle, texBtnLabel: this.state.textureOn ? 'Textura: activa' : 'Textura: en calma',
      kicker: c.kicker, kickerRef: this.kickerRef,
      headPre: c.headPre, headWord: c.headWord, headPost: c.headPost, wordRef: this.wordRef,
      sub: c.sub,
      ctaStyle, ctaPrimary: c.ctaPrimary, ctaNote: c.ctaNote,
      counterRef: this.counterRef, counterInit: this._reduce ? this.counterTarget(ctx).toLocaleString('es-MX') : '0',
      counterLabel: c.counterLabel,
      cardsKicker: dark ? 'Cuando estés lista, esto te espera' : 'Tres formas de empezar',
      cardStyle,
      switcherStyle, ctxOptions
    };
  }
}
</script>
</body>
</html>
